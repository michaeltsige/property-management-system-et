# Keep the build context small; everything below is re-created inside the image
# by the build stage (pnpm install + pnpm build), so shipping it is pure waste.
.git
.gitignore
# Secrets at every level (root .env, apps/api/.env, ...); keep the examples.
**/.env
**/.env.*
!**/.env.example
node_modules
**/node_modules
**/.next
**/dist
**/build
**/*.tsbuildinfo
.turbo
**/.turbo
coverage
**/coverage
# Runtime upload dirs only — anchored like .gitignore, so this does NOT
# swallow the storage driver source at apps/api/src/storage/.
/storage
/apps/api/storage
*.log
.DS_Store
docs/screenshots
apps/web/public/images/login-hero.jpg.bak
