# ---------------------------------------------------------------------------
# Property Management System ET - example environment file.
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000
# Public base URL of the API (used in provider webhook URLs)
API_PUBLIC_URL=http://localhost:4000

# --- Database ----------------------------------------------------------
# Local docker-compose Postgres (see docker-compose.yml)
DATABASE_URL=postgresql://pms:pms@localhost:5432/pms_dev?schema=public
# Used by the test suite (Integration tests truncate this database)
TEST_DATABASE_URL=postgresql://pms:pms@localhost:5432/pms_test?schema=public

# --- Auth --------------------------------------------------------------
# Generate with: openssl rand -base64 48    (min 32 chars, different per env)
JWT_ACCESS_SECRET=change-me-development-only-access-secret-32chars
JWT_REFRESH_SECRET=change-me-development-only-refresh-secret-32chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Platform operators may create organizations; comma separated emails
PLATFORM_ADMIN_EMAILS=admin@example.com

# --- Background jobs (pg-boss) ----------------------------------------
JOBS_ENABLED=true
WORKER_CRON_CHARGE_GENERATION=0 2 * * *
WORKER_CRON_OVERDUE_SWEEP=30 2 * * *

# --- Payment providers -------------------------------------------------
# mock | telebirr | chapa     (telebirr/chapa require real credentials)
PAYMENT_PROVIDER=mock
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_SHORT_CODE=

# --- SMS / notifications ----------------------------------------------
# mock | ethio-telecom-sms
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_NAME=

# --- File storage ------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_BYTES=10485760
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Field encryption ---------------------------------------------------
# AES-256-GCM key for tenant ID numbers. Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=change-me-development-only-field-encryption-key

# --- Auth rate limiting -------------------------------------------------
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# --- Web app (apps/web) -------------------------------------------------
# The browser calls the API through the Next.js server (relative /api/v1 URLs).
# This is where that server-side proxy points. Never exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:4000
