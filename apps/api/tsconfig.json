{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    // Applications are not consumed as libraries, so no .d.ts emit. This also
    // avoids TS2742 "inferred type cannot be named" noise from pnpm's nested
    // @types paths.
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "dist", "node_modules"]
}
