{
  "name": "@pms/web",
  "version": "0.1.0",
  "private": true,
  "description": "Property management web app (Next.js App Router + Tailwind + shadcn/ui)",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "dev:port": "next dev --hostname 0.0.0.0 --port"
  },
  "dependencies": {
    "@pms/calendar": "workspace:*",
