    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint-config-next": "^15.5.27",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
